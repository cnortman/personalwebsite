---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { padIndex } from '../lib/projects';

const evidence = [
  { subject: 'Deloitte', lesson: 'Learned complex financial systems.' },
  { subject: 'AI IPO Platform', lesson: 'Applied that understanding to technology.' },
  { subject: 'Blackwater', lesson: 'Learned market and data infrastructure.' },
  { subject: 'TRACE', lesson: 'Combined financial reporting, data, and software to map supply chains.' },
  { subject: 'This website', lesson: 'Demonstrates the entire intersection.' },
];
---

<BaseLayout title="About">
  <PageHeader
    eyebrow="About"
    title="I learn systems, understand the problem, and build things to solve it."
    lede="I don't identify primarily as an auditor, an analyst, or a software engineer. The common thread is learning how something works well enough to make it better."
  />

  <section class="container page-body" aria-labelledby="evidence-title">
    <h2 id="evidence-title" class="eyebrow">The evidence</h2>
    <ol class="evidence" role="list">
      {
        evidence.map((item, i) => (
          <li>
            <span class="mono muted">{padIndex(i + 1)}</span>
            <span class="subject">{item.subject}</span>
            <span class="lesson">{item.lesson}</span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .evidence {
    margin-top: var(--space-3);
  }

  .evidence li {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    align-items: baseline;
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .evidence .mono {
    grid-column: span 1;
    font-size: var(--text-xs);
  }

  .subject {
    grid-column: span 4;
    font-size: var(--text-xl);
    font-weight: 520;
    letter-spacing: -0.015em;
  }

  .lesson {
    grid-column: span 7;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1023px) {
    .subject {
      grid-column: span 3;
    }

    .lesson {
      grid-column: span 4;
    }
  }

  @media (max-width: 719px) {
    .evidence li {
      row-gap: 4px;
    }

    .evidence .mono {
      grid-column: 1 / -1;
    }

    .subject,
    .lesson {
      grid-column: 1 / -1;
    }
  }
</style>
