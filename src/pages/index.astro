---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Intersection from '../components/intersection/Intersection.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import Timeline from '../components/experience/Timeline.astro';
import Status from '../components/ui/Status.astro';
import { getProjects, padIndex } from '../lib/projects';
import { learningLoop, systemFlow } from '../data/technologies';
import { contactLinks } from '../data/site';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const tracked = projects.filter((project) => project.data.status);
const heroWords = ['Learning', 'Building', 'Analyzing'];
---

<BaseLayout>
  <!-- 01 Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__lines" aria-hidden="true">
      <div class="container grid hero__lines-grid">
        {Array.from({ length: 12 }, () => <span />)}
      </div>
    </div>

    <div class="container grid hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Finance <span class="x">×</span> Data <span class="x">×</span> Software</p>
        <h1 id="hero-title" class="display hero__title">
          {
            heroWords.map((word, i) => (
              <span class="hero__word" style={`--i: ${i}`}>
                <span class="hero__word-inner">
                  {word}
                  <span class="hero__dot">.</span>
                </span>{' '}
              </span>
            ))
          }
        </h1>
        <p class="lede">
          Finance professional building analytical tools, data products, and software at the intersection of investment
          and technology.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="/experience">View experience <span aria-hidden="true">→</span></a>
          <a class="button" href="/projects">Projects</a>
        </div>
      </div>

      <aside class="readout" aria-label="At a glance">
        <dl>
          <div>
            <dt class="eyebrow muted">Focus</dt>
            <dd>Investment analytics</dd>
          </div>
          <div>
            <dt class="eyebrow muted">Disciplines</dt>
            <dd>Finance · Data · Software</dd>
          </div>
          <div>
            <dt class="eyebrow muted">Stack</dt>
            <dd class="mono">Python · SQL · TypeScript</dd>
          </div>
          <div>
            <dt class="eyebrow muted">Current build</dt>
            <dd><a href="/projects/trace">TRACE</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <Section id="intersection" index="02" label="The intersection" title="Three disciplines. One workflow.">
    <Intersection />
  </Section>

  <Section id="experience" index="03" label="Work experience" title="From financial systems to software.">
    <Timeline />
    <a class="link-arrow more" href="/experience">Full work experience <span aria-hidden="true">→</span></a>
  </Section>

  <Section id="projects" index="04" label="Projects" title="Things I've built.">
    <div class="work-grid">
      {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
    <a class="link-arrow more" href="/projects">All projects <span aria-hidden="true">→</span></a>
  </Section>

  <Section id="system" index="05" label="Technical system" title="How the tools connect.">
    <ol class="flow" role="list">
      {
        systemFlow.map((step, i) => (
          <li class="flow__step">
            <div class="flow__group">
              {step.map((node) => (
                <span class:list={['flow__node', { 'flow__node--domain': i === 0 || i === systemFlow.length - 1 }]}>
                  {node}
                </span>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="learning" index="06" label="How I learn" title="I don't need to know everything before I start.">
    <div class="grid">
      <ol class="loop" role="list">
        {
          learningLoop.map((stage, i) => (
            <li class:list={['loop__stage', { 'is-highlighted': stage === 'Build' }]}>
              <span class="mono muted">{padIndex(i + 1)}</span>
              {stage}
            </li>
          ))
        }
      </ol>
      <blockquote class="quote">
        <p class="eyebrow">Build</p>
        <p class="h3">
          I usually learn technologies fastest by building something that forces me to understand the underlying system.
        </p>
      </blockquote>
    </div>
  </Section>

  <Section id="live" index="07" label="Live data" title="The site is connected to the world.">
    <div class="live">
      <div class="panel">
        <p class="eyebrow muted panel__title">Project status</p>
        <ul role="list" class="status-list">
          {
            tracked.map((project) => (
              <li>
                <a href={`/projects/${project.id}`}>{project.data.title}</a>
                {project.data.status && <Status status={project.data.status} />}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow muted panel__title">GitHub activity</p>
        <dl class="request">
          <div><dt>Request</dt><dd>GET /api/github/activity</dd></div>
          <div><dt>Status</dt><dd>In development</dd></div>
        </dl>
      </div>
      <div class="panel">
        <p class="eyebrow muted panel__title">Market data</p>
        <dl class="request">
          <div><dt>Request</dt><dd>GET /api/market/overview</dd></div>
          <div><dt>Status</dt><dd>In development</dd></div>
        </dl>
      </div>
    </div>
  </Section>

  <Section id="notes" index="08" label="Notes" title="Short research notes.">
    <p class="lede">
      Financial analytics, SQL, data engineering, investment analysis, and what I learn while building software. The
      first notes are in progress.
    </p>
    <a class="link-arrow more" href="/notes">Notes <span aria-hidden="true">→</span></a>
  </Section>

  <Section id="contact" index="09" label="Contact" title="Let's build something useful.">
    <ul class="contact" role="list">
      {
        contactLinks.map((link) => (
          <li>
            <a href={link.href}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
      <li><a href="/resume">Resume <span aria-hidden="true">→</span></a></li>
    </ul>
  </Section>
</BaseLayout>

<style>
  /* 01 Hero */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(100svh - var(--header-height));
    padding-block: var(--space-12) var(--space-10);
    overflow: hidden;
  }

  .hero__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 60%, transparent);
  }

  .hero__lines-grid {
    height: 100%;
    grid-template-rows: 100%;
  }

  .hero__lines span {
    border-inline-start: 1px solid color-mix(in srgb, var(--color-border) 55%, transparent);
  }

  .hero__lines span:nth-child(12) {
    border-inline-end: 1px solid color-mix(in srgb, var(--color-border) 55%, transparent);
  }

  .hero__inner {
    position: relative;
    align-items: end;
  }

  .hero__copy {
    grid-column: 1 / span 8;
  }

  .hero__copy > :not(h1) {
    animation: fade-up var(--duration-slow) var(--ease-out) both;
  }

  .hero__copy > :nth-child(3) { animation-delay: 420ms; }
  .hero__copy > :nth-child(4) { animation-delay: 500ms; }

  .hero__title {
    margin-top: var(--space-3);
  }

  /* Each word rises into view from behind its own mask. */
  .hero__word {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero__word-inner {
    display: inline-block;
    animation: word-up 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 120ms + 80ms);
  }

  .hero__dot {
    color: var(--color-accent);
  }

  .hero .lede {
    margin-top: var(--space-3);
  }

  .x {
    color: var(--color-accent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--space-5);
  }

  .readout {
    grid-column: 9 / span 4;
    padding: var(--space-1) var(--space-3);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    animation: fade-up var(--duration-slow) var(--ease-out) 560ms both;
  }

  .readout div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: 14px;
    font-size: var(--text-sm);
  }

  .readout div + div {
    border-top: 1px solid var(--color-border);
  }

  .readout dd {
    text-align: right;
  }

  /* Shared */
  .more {
    margin-top: var(--space-5);
  }

  /* 05 Technical system */
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .flow__step {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .flow__step:not(:last-child)::after {
    content: '→' / '';
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .flow__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .flow__node {
    padding: 10px var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-align: center;
  }

  .flow__node--domain {
    border-color: var(--color-border-strong);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* 06 How I learn */
  .loop {
    grid-column: 1 / span 7;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-1);
  }

  .loop__stage {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .loop__stage .mono {
    font-size: var(--text-xs);
  }

  .loop__stage.is-highlighted {
    border-color: var(--color-accent);
  }

  .quote {
    grid-column: 9 / span 4;
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent);
  }

  .quote .h3 {
    margin-top: var(--space-1);
  }

  /* 07 Live data */
  .live {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .panel__title {
    margin-bottom: var(--space-2);
  }

  .status-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding-block: 10px;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .status-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .request {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .request div {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-2);
    padding-block: 10px;
    border-top: 1px solid var(--color-border);
  }

  .request dt {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .request dd {
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  /* 09 Contact */
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .contact a {
    display: inline-flex;
    gap: var(--space-1);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-border-strong);
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .contact a:hover {
    border-color: var(--color-text);
  }

  .contact span {
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .hero__lines span:nth-child(n + 9) {
      display: none;
    }

    .hero__lines span:nth-child(8) {
      border-inline-end: 1px solid color-mix(in srgb, var(--color-border) 55%, transparent);
    }

    .hero__copy,
    .readout,
    .loop,
    .quote {
      grid-column: 1 / -1;
    }

    .live {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 719px) {
    .hero {
      min-height: auto;
      padding-block: var(--space-10) var(--space-8);
    }

    .hero__lines span:nth-child(n + 5) {
      display: none;
    }

    .hero__lines span:nth-child(4) {
      border-inline-end: 1px solid color-mix(in srgb, var(--color-border) 55%, transparent);
    }

    .flow,
    .flow__step {
      flex-direction: column;
      align-items: flex-start;
    }

    .flow__step:not(:last-child)::after {
      content: '↓' / '';
      padding-left: var(--space-2);
    }

    .flow__group {
      flex-direction: row;
    }

    .contact a {
      font-size: var(--text-xl);
    }
  }
</style>
