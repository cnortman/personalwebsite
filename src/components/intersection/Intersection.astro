---
import { disciplines, references, type ReferenceKey } from '../../data/technologies';
import { padIndex } from '../../lib/projects';

const circles = [
  { id: 'finance', label: 'Finance', cx: 240, cy: 170, lx: 240, ly: 92, dx: 0, dy: -44 },
  { id: 'data', label: 'Data', cx: 168, cy: 295, lx: 112, ly: 350, dx: -40, dy: 26 },
  { id: 'software', label: 'Software', cx: 312, cy: 295, lx: 368, ly: 350, dx: 40, dy: 26 },
];
const core = { x: 240, y: 253 };
const flows = [
  { id: 'finance', d: `M240 30 L${core.x} ${core.y}` },
  { id: 'data', d: `M52 368 L${core.x} ${core.y}` },
  { id: 'software', d: `M428 368 L${core.x} ${core.y}` },
];

const unique = (keys: ReferenceKey[]) => [...new Set(keys)];
const panels = [
  ...disciplines.map((discipline) => ({
    key: `discipline:${discipline.id}`,
    context: 'Discipline',
    title: discipline.label,
    refs: unique(discipline.skills.flatMap((skill) => skill.refs)),
  })),
  ...disciplines.flatMap((discipline) =>
    discipline.skills.map((skill) => ({
      key: `skill:${skill.id}`,
      context: discipline.label,
      title: skill.label,
      refs: skill.refs,
    })),
  ),
];
const groups = [
  { kind: 'experience', label: 'Work experience' },
  { kind: 'project', label: 'Projects' },
] as const;
---

<div class="intersection" data-intersection data-state="apart">
  <div class="venn-wrap">
    <svg class="venn" viewBox="0 0 480 450" role="img" aria-labelledby="venn-title">
      <title id="venn-title">Finance, data, and software overlap. Their intersection is where I build.</title>

      <g class="guides" aria-hidden="true">
        {flows.map((flow) => <path id={`flow-${flow.id}`} d={flow.d} />)}
      </g>

      {
        circles.map((circle) => (
          <g class="circle" data-circle={circle.id} style={`--dx: ${circle.dx}px; --dy: ${circle.dy}px`}>
            <circle cx={circle.cx} cy={circle.cy} r="130" />
            <text x={circle.lx} y={circle.ly} class="circle__label">
              {circle.label}
            </text>
          </g>
        ))
      }

      <g class="particles" aria-hidden="true">
        {
          flows.map((flow, i) =>
            [0, 1].map((j) => {
              const begin = `-${(i * 1.1 + j * 1.8).toFixed(1)}s`;
              return (
                <circle r="2.5" class="particle">
                  <animateMotion dur="3.6s" begin={begin} repeatCount="indefinite">
                    <mpath href={`#flow-${flow.id}`} />
                  </animateMotion>
                  <animate
                    attributeName="opacity"
                    values="0;1;1;0"
                    keyTimes="0;0.2;0.8;1"
                    dur="3.6s"
                    begin={begin}
                    repeatCount="indefinite"
                  />
                </circle>
              );
            }),
          )
        }
      </g>

      <g class="core" aria-hidden="true">
        <g class="core__ring">
          <circle cx={core.x} cy={core.y} r="50" />
        </g>
        <circle class="core__disc" cx={core.x} cy={core.y} r="37" />
        <text x={core.x} y={core.y} class="core__label">BUILD</text>
      </g>
    </svg>
  </div>

  <div class="explorer">
    <div class="columns">
      {
        disciplines.map((discipline) => (
          <div class="col">
            <button type="button" class="col__head" data-discipline-trigger={discipline.id} aria-pressed="false">
              <span class="eyebrow">{discipline.label}</span>
              <span class="mono muted">{padIndex(discipline.skills.length)}</span>
            </button>
            <ul role="list" class="skills">
              {discipline.skills.map((skill) => (
                <li>
                  <button
                    type="button"
                    class="skill"
                    data-skill={skill.id}
                    data-discipline={discipline.id}
                    data-refs={skill.refs.join(' ')}
                    aria-pressed="false"
                  >
                    {skill.label}
                    <span class="skill__count mono" aria-hidden="true">
                      {skill.refs.length}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="related" aria-live="polite">
      <div class="related__panel" data-panel="default">
        <p class="eyebrow muted">Where it shows up</p>
        <p class="related__title">Every skill is backed by real work.</p>
        <p class="related__hint">
          Hover or select a discipline or skill to see the work experience and projects behind it, and which other skills
          light up alongside it.
        </p>
      </div>
      {
        panels.map((panel) => (
          <div class="related__panel" data-panel={panel.key} hidden>
            <p class="eyebrow muted">{panel.context} · Where it shows up</p>
            <p class="related__title">{panel.title}</p>
            <div class="related__groups">
              {groups.map((group) => {
                const keys = panel.refs.filter((key) => references[key].kind === group.kind);
                return (
                  <div class="related__group">
                    <p class="eyebrow muted">
                      {group.label} <span class="mono">{padIndex(keys.length)}</span>
                    </p>
                    {keys.length > 0 ? (
                      <ul role="list">
                        {keys.map((key, i) => (
                          <li style={`--i: ${i}`}>
                            <a href={references[key].href}>{references[key].label}</a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="related__empty mono">—</p>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
      <p class="related__keys mono" aria-hidden="true">Click to pin · Esc to clear</p>
    </div>
  </div>
</div>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('[data-intersection]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    // Circles converge when the section scrolls into view; looping animations
    // only run while it is on screen.
    const svg = root.querySelector<SVGSVGElement>('.venn');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    svg?.pauseAnimations();
    if (reduceMotion || !('IntersectionObserver' in window)) {
      root.dataset.state = 'converged';
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          root.dataset.visible = String(entry.isIntersecting);
          if (entry.isIntersecting) {
            root.dataset.state = 'converged';
            svg?.unpauseAnimations();
          } else {
            svg?.pauseAnimations();
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(root);
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    }

    const skills = [...root.querySelectorAll<HTMLButtonElement>('[data-skill]')];
    const heads = [...root.querySelectorAll<HTMLButtonElement>('[data-discipline-trigger]')];
    const circles = [...root.querySelectorAll<SVGGElement>('[data-circle]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const refsOf = (skill: HTMLElement) => (skill.dataset.refs ?? '').split(' ').filter(Boolean);
    let pinned: string | null = null;

    function show(key: string | null) {
      const [type, id] = key ? key.split(':') : [null, null];
      const activeSkill = type === 'skill' ? skills.find((skill) => skill.dataset.skill === id) : undefined;
      const discipline = type === 'discipline' ? id : (activeSkill?.dataset.discipline ?? null);
      const refs = new Set(activeSkill ? refsOf(activeSkill) : []);
      const relatedDisciplines = new Set<string>();

      for (const skill of skills) {
        const isActive = skill === activeSkill;
        const isRelated = !isActive && refs.size > 0 && refsOf(skill).some((ref) => refs.has(ref));
        const inDiscipline = type === 'discipline' && skill.dataset.discipline === discipline;
        skill.classList.toggle('is-active', isActive || inDiscipline);
        skill.classList.toggle('is-related', isRelated);
        skill.classList.toggle('is-dim', key !== null && !isActive && !isRelated && !inDiscipline);
        skill.setAttribute('aria-pressed', String(pinned === `skill:${skill.dataset.skill}`));
        if (isRelated && skill.dataset.discipline) relatedDisciplines.add(skill.dataset.discipline);
      }

      for (const head of heads) {
        const id = head.dataset.disciplineTrigger;
        head.classList.toggle('is-active', id === discipline);
        head.setAttribute('aria-pressed', String(pinned === `discipline:${id}`));
      }

      for (const circle of circles) {
        const id = circle.dataset.circle ?? '';
        const isActive = id === discipline;
        const isRelated = !isActive && relatedDisciplines.has(id);
        circle.classList.toggle('is-active', isActive);
        circle.classList.toggle('is-related', isRelated);
        circle.classList.toggle('is-dim', key !== null && !isActive && !isRelated);
      }

      const panelKey = key ?? 'default';
      for (const panel of panels) panel.hidden = panel.dataset.panel !== panelKey;
    }

    const preview = (key: string) => {
      if (!pinned) show(key);
    };
    const togglePin = (key: string) => {
      pinned = pinned === key ? null : key;
      show(pinned ?? key);
    };

    for (const skill of skills) {
      const key = `skill:${skill.dataset.skill}`;
      skill.addEventListener('pointerenter', () => preview(key));
      skill.addEventListener('focus', () => preview(key));
      skill.addEventListener('click', () => togglePin(key));
    }

    for (const head of heads) {
      const key = `discipline:${head.dataset.disciplineTrigger}`;
      head.addEventListener('pointerenter', () => preview(key));
      head.addEventListener('focus', () => preview(key));
      head.addEventListener('click', () => togglePin(key));
    }

    for (const circle of circles) {
      const key = `discipline:${circle.dataset.circle}`;
      circle.addEventListener('pointerenter', () => preview(key));
      circle.addEventListener('click', () => togglePin(key));
    }

    root.addEventListener('pointerleave', () => {
      if (!pinned) show(null);
    });
    root.addEventListener('focusout', (event) => {
      if (!pinned && !root.contains(event.relatedTarget as Node | null)) show(null);
    });
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      pinned = null;
      show(null);
    });
  }

  // Runs on first load and after every client-side navigation.
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .intersection {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-6);
    align-items: center;
  }

  .venn-wrap {
    grid-column: 1 / span 5;
  }

  .explorer {
    grid-column: 7 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Diagram */
  .venn {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .guides path {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-dasharray: 2 6;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity 600ms var(--ease-out) 900ms;
  }

  .circle {
    cursor: pointer;
    opacity: 0.4;
    transform: translate(var(--dx), var(--dy));
    transition:
      transform 1400ms var(--ease-out),
      opacity 700ms var(--ease-out);
  }

  .circle circle {
    fill: color-mix(in srgb, var(--color-text) 3%, transparent);
    stroke: var(--color-border-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition:
      fill var(--duration-base) var(--ease-out),
      stroke var(--duration-base) var(--ease-out);
  }

  .circle__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-anchor: middle;
    fill: var(--color-text-secondary);
    transition: fill var(--duration-base) var(--ease-out);
  }

  .core {
    opacity: 0;
    transform: scale(0.6);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 600ms var(--ease-out) 800ms,
      transform 900ms var(--ease-out) 800ms;
  }

  .core__ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 40s linear infinite;
    animation-play-state: paused;
  }

  [data-visible='true'] .core__ring {
    animation-play-state: running;
  }

  .core__ring circle {
    fill: none;
    stroke: var(--color-accent);
    stroke-opacity: 0.5;
    stroke-dasharray: 3 7;
    vector-effect: non-scaling-stroke;
  }

  .core__disc {
    fill: var(--color-bg);
    stroke: var(--color-accent);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .core__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-anchor: middle;
    dominant-baseline: central;
    fill: var(--color-accent);
  }

  .particles {
    opacity: 0;
    transition: opacity 600ms var(--ease-out) 1300ms;
  }

  .particle {
    fill: var(--color-accent-secondary);
  }

  [data-state='converged'] .circle {
    opacity: 1;
    transform: none;
  }

  [data-state='converged'] .guides path,
  [data-state='converged'] .particles,
  [data-state='converged'] .core {
    opacity: 1;
  }

  [data-state='converged'] .core {
    transform: none;
  }

  [data-state='converged'] .circle.is-dim {
    opacity: 0.3;
  }

  .circle.is-active circle {
    fill: color-mix(in srgb, var(--color-accent) 13%, transparent);
    stroke: var(--color-accent);
  }

  .circle.is-active .circle__label {
    fill: var(--color-text);
  }

  .circle.is-related circle {
    fill: color-mix(in srgb, var(--color-accent) 5%, transparent);
    stroke: color-mix(in srgb, var(--color-accent) 50%, var(--color-border-strong));
  }

  /* Explorer */
  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .col__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    padding: 0 0 var(--space-1);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-border-strong);
    cursor: pointer;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .col__head .eyebrow {
    color: var(--color-text);
  }

  .col__head.is-active {
    border-color: var(--color-accent);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-2);
  }

  .skill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 6px 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-text-secondary);
    text-align: left;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .skill__count {
    font-size: 0.625rem;
    color: var(--color-text-muted);
  }

  .skill.is-active {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .skill.is-related {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
  }

  .skill.is-dim {
    opacity: 0.4;
  }

  .skill[aria-pressed='true'] {
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  .related {
    position: relative;
    min-height: 196px;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .related__panel {
    animation: fade-up 320ms var(--ease-out) both;
  }

  .related__title {
    margin-top: 6px;
    font-size: var(--text-xl);
    font-weight: 520;
    letter-spacing: -0.015em;
  }

  .related__hint {
    max-width: 48ch;
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
  }

  .related__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .related__group ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: var(--space-1);
  }

  .related__group li {
    animation: fade-up 420ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }

  .related__group a {
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .related__group a:hover {
    text-decoration-color: var(--color-accent);
  }

  .related__empty {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  .related__keys {
    position: absolute;
    right: var(--space-3);
    bottom: 12px;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .venn-wrap {
      grid-column: 1 / -1;
      width: 100%;
      max-width: 420px;
      margin-inline: auto;
    }

    .explorer {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 719px) {
    .columns,
    .related__groups {
      grid-template-columns: minmax(0, 1fr);
    }

    .related {
      padding-bottom: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .particles {
      display: none;
    }
  }
</style>
