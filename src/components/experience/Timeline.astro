---
import { experienceByYear } from '../../data/experience';

interface Props {
  /** Show metrics, highlights, and tools for each role. */
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
---

<ol class:list={['timeline', { 'is-detailed': detailed }]} role="list">
  {
    experienceByYear.map(({ year, entries }) => (
      <li class="year">
        <p class="mono year__label">{year}</p>
        <ul class="entries" role="list">
          {entries.map((entry) => (
            <li class="entry" id={detailed ? entry.id : undefined}>
              <span class="node" aria-hidden="true" />
              <div class="entry__body">
                <p class="entry__title">{entry.organization}</p>
                <ul class="roles" role="list">
                  {entry.roles.map((role) => (
                    <li class="role">
                      <p class="role__title">
                        {role.title}
                        {role.note && <span class="role__note"> · {role.note}</span>}
                        {!detailed && role.metrics[0] && ' '}
                        {!detailed && role.metrics[0] && (
                          <span class="role__metric mono">
                            {role.metrics[0].value} {role.metrics[0].label}
                          </span>
                        )}
                      </p>
                      {detailed && (role.dates || role.location) && (
                        <p class="role__meta mono">{[role.dates, role.location].filter(Boolean).join(' · ')}</p>
                      )}
                      {detailed && role.metrics.length > 0 && (
                        <dl class="metrics">
                          {role.metrics.map((metric) => (
                            <div class="metric">
                              <dt>{metric.label}</dt>
                              <dd class="mono">{metric.value}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                      {detailed && role.highlights.length > 0 && (
                        <ul class="highlights">
                          {role.highlights.map((highlight) => (
                            <li>{highlight}</li>
                          ))}
                        </ul>
                      )}
                      {detailed && role.tools.length > 0 && (
                        <ul class="tags" role="list" aria-label="Tools and focus areas">
                          {role.tools.map((tool) => (
                            <li class="chip">{tool}</li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .year {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .year__label {
    grid-column: 1 / span 3;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .entries {
    grid-column: 4 / -1;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .entries::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 4px;
    width: 1px;
    background: var(--color-border);
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr);
    gap: var(--space-2);
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .node {
    width: 9px;
    height: 9px;
    margin-top: 0.55em;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .entry__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .entry__title {
    font-size: var(--text-xl);
    font-weight: 520;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .role {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .role__title {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .role__note {
    color: var(--color-text-muted);
  }

  .role__meta {
    margin-top: 4px;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .role__metric {
    display: inline-block;
    margin-left: 10px;
    padding: 1px 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    min-width: 140px;
    padding: 10px 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .metric dd {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .metric dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 72ch;
    padding-left: 1.1em;
    color: var(--color-text-secondary);
  }

  .highlights li::marker {
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Detailed view: each role reads as its own block. */
  .is-detailed .entries {
    gap: var(--space-6);
  }

  .is-detailed .roles {
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .is-detailed .role {
    gap: var(--space-2);
  }

  .is-detailed .role + .role {
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
  }

  .is-detailed .role__title {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
  }

  @media (max-width: 1023px) {
    .year__label {
      grid-column: 1 / span 2;
    }

    .entries {
      grid-column: 3 / -1;
    }
  }

  @media (max-width: 719px) {
    .year__label,
    .entries {
      grid-column: 1 / -1;
    }

    .role__metric {
      display: table;
      margin: 6px 0 0;
    }
  }
</style>
