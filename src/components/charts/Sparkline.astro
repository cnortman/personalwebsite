---
/**
 * Decorative, deterministic sparkline. The same seed always draws the same
 * line, so a project's card and its page share an identical shape for the
 * view transition. Not real data — hidden from assistive technology.
 */
interface Props {
  seed: string;
  width?: number;
  height?: number;
  points?: number;
}

const { seed, width = 320, height = 88, points = 56 } = Astro.props;

function hash(input: string) {
  let h = 2166136261;
  for (const char of input) {
    h ^= char.charCodeAt(0);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32(state: number) {
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = mulberry32(hash(seed));
const values: number[] = [];
let value = 0;
for (let i = 0; i < points; i++) {
  value += random() - 0.44;
  values.push(value);
}

const min = Math.min(...values);
const max = Math.max(...values);
const pad = 6;
const coords = values.map((v, i) => [
  (i / (points - 1)) * width,
  pad + (1 - (v - min) / (max - min || 1)) * (height - pad * 2),
]);
const line = coords.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = `${line} L${width} ${height} L0 ${height} Z`;
const gradientId = `sparkline-${hash(seed).toString(36)}-${width}`;
---

<svg class="sparkline" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={gradientId} x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="currentColor" stop-opacity="0.16"></stop>
      <stop offset="100%" stop-color="currentColor" stop-opacity="0"></stop>
    </linearGradient>
  </defs>
  <path d={area} fill={`url(#${gradientId})`}></path>
  <path
    class="sparkline__line"
    d={line}
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
    pathLength="1"></path>
</svg>

<style>
  .sparkline {
    width: 100%;
    height: auto;
    aspect-ratio: var(--sparkline-ratio, auto);
  }
</style>
