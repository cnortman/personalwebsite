---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Sparkline from '../components/charts/Sparkline.astro';
import Status from '../components/ui/Status.astro';
import { padIndex, type Project } from '../lib/projects';

interface Props {
  project: Project;
  headings: MarkdownHeading[];
  index: number;
  next?: Project;
}

const { project, headings, index, next } = Astro.props;
const { title, summary, category, tagline, technologies, status, metrics, cover, coverAlt, video, year } = project.data;
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={title} description={summary} type="article">
  <article>
    <header class="project-header">
      <div class="container">
        <a href="/projects" class="back">
          <span aria-hidden="true">←</span> All projects
        </a>

        <div class:list={['intro', video ? 'intro--wrap' : 'grid']}>
          {
            video && (
              <div class="visual visual--media visual--float" transition:name={`project-visual-${project.id}`}>
                <video
                  class="media"
                  src={video.src}
                  poster={video.poster}
                  aria-label={video.label}
                  controls
                  muted
                  loop
                  playsinline
                  autoplay
                  preload="metadata"
                />
                <button type="button" class="expand" data-video-expand aria-haspopup="dialog">
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                    <path d="M10 2h4v4M6 14H2v-4M14 2 9 7M2 14l5-5" fill="none" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                  Expand
                </button>
              </div>
            )
          }
          <div class="intro__copy">
            <p class="eyebrow"><span class="muted">{padIndex(index + 1)}</span>&ensp;{category}</p>
            <h1 class="h1" transition:name={`project-title-${project.id}`}>{title}</h1>
            <p class="lede">{summary}</p>
          </div>

          <dl class="meta">
            {
              status && (
                <div>
                  <dt class="eyebrow muted">Status</dt>
                  <dd>
                    <Status status={status} />
                  </dd>
                </div>
              )
            }
            {
              year && (
                <div>
                  <dt class="eyebrow muted">Year</dt>
                  <dd class="mono">{year}</dd>
                </div>
              )
            }
            <div>
              <dt class="eyebrow muted">Focus</dt>
              <dd class="mono">{tagline}</dd>
            </div>
            <div>
              <dt class="eyebrow muted">Stack</dt>
              <dd>
                <ul class="chips" role="list">
                  {technologies.map((technology) => <li class="chip">{technology}</li>)}
                </ul>
              </dd>
            </div>
            {
              metrics.map((metric) => (
                <div>
                  <dt class="eyebrow muted">{metric.label}</dt>
                  <dd class="mono">{metric.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        {
          !video && (
            <div class:list={['visual', { 'visual--media': cover }]} transition:name={`project-visual-${project.id}`}>
              {cover ? (
                <Image class="media" src={cover} alt={coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
              ) : (
                <Sparkline seed={project.id} width={1200} height={220} />
              )}
            </div>
          )
        }
      </div>

      {
        video && (
          <dialog class="lightbox" data-video-lightbox aria-label={video.label}>
            <div class="lightbox__inner">
              <button type="button" class="lightbox__close" data-video-close>
                Close <span aria-hidden="true">✕</span>
              </button>
              <video class="lightbox__video" src={video.src} poster={video.poster} controls muted loop playsinline preload="none" />
            </div>
          </dialog>
        )
      }
    </header>

    <div class="container grid body">
      <nav class="toc" aria-label="Case study sections">
        <p class="eyebrow muted">Contents</p>
        <ol role="list">
          {
            sections.map((heading, i) => (
              <li>
                <a href={`#${heading.slug}`}>
                  <span class="mono muted">{padIndex(i + 1)}</span>
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="prose">
        <slot />
      </div>
    </div>

    {
      next && (
        <footer class="next">
          <a href={`/projects/${next.id}`} class="container next__link">
            <span class="eyebrow muted">Next project</span>
            <span class="h2 next__title">
              {next.data.title} <span aria-hidden="true" class="next__arrow">→</span>
            </span>
          </a>
        </footer>
      )
    }
  </article>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const inline = document.querySelector<HTMLVideoElement>('.visual video');
    if (!inline) return;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Header videos autoplay muted; leave them paused for visitors who prefer reduced motion.
    if (reduceMotion) {
      inline.autoplay = false;
      inline.pause();
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-video-lightbox]');
    const large = dialog?.querySelector('video');
    if (!dialog || !large) return;

    // Expanding hands playback to the large copy at the same moment; closing hands it back.
    let resumeInline = false;
    let handedBack = true;
    const handBack = () => {
      if (handedBack) return;
      handedBack = true;
      large.pause();
      inline.currentTime = large.currentTime;
      if (resumeInline) inline.play().catch(() => {});
    };
    const close = () => {
      dialog.close();
      handBack();
    };

    document.querySelector('[data-video-expand]')?.addEventListener('click', () => {
      resumeInline = !inline.paused;
      handedBack = false;
      inline.pause();
      large.currentTime = inline.currentTime;
      dialog.showModal();
      if (!reduceMotion) large.play().catch(() => {});
    });
    dialog.querySelector('[data-video-close]')?.addEventListener('click', close);
    // A click on the backdrop lands on the dialog itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    // Esc closes the dialog natively.
    dialog.addEventListener('close', handBack);
  });
</script>

<style>
  .project-header {
    padding-block: var(--space-6) var(--space-8);
  }

  .back {
    display: inline-flex;
    gap: var(--space-1);
    margin-bottom: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .back:hover {
    color: var(--color-text);
  }

  .intro {
    align-items: end;
  }

  .intro__copy {
    grid-column: 1 / span 7;
  }

  .intro__copy > * + * {
    margin-top: var(--space-2);
  }

  /* With a video, the copy and meta wrap around it instead of sitting in columns. */
  .intro--wrap {
    display: flow-root;
  }

  .intro--wrap .meta {
    margin-top: var(--space-5);
  }

  .visual.visual--float {
    float: right;
    width: min(58%, 720px);
    margin: 0 0 var(--space-3) var(--space-6);
  }

  @media (max-width: 719px) {
    .visual.visual--float {
      float: none;
      width: 100%;
      margin: 0 0 var(--space-5);
    }
  }

  .meta {
    grid-column: 9 / span 4;
  }

  .meta > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding-block: 12px;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .meta dd {
    text-align: right;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }

  .visual {
    margin-top: var(--space-8);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  .visual--media {
    position: relative;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
  }

  .expand {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .expand:hover {
    border-color: var(--color-text);
  }

  .expand:focus-visible,
  .lightbox__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lightbox {
    width: min(1400px, calc(100vw - 2 * var(--gutter)));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.82);
    backdrop-filter: blur(4px);
  }

  .lightbox__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }

  .lightbox__close {
    display: inline-flex;
    gap: 8px;
    padding: 6px 10px;
    background: transparent;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
  }

  .lightbox__close:hover {
    border-color: #fff;
  }

  .lightbox__video {
    display: block;
    width: 100%;
    max-height: calc(100vh - 120px);
    background: #000;
    border-radius: var(--radius-lg);
  }

  .media {
    display: block;
    width: 100%;
    height: auto;
  }

  .body {
    align-items: start;
    padding-block: var(--space-8) var(--space-12);
  }

  .toc {
    grid-column: 1 / span 3;
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .toc a {
    display: flex;
    gap: 12px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .toc a:hover {
    color: var(--color-text);
  }

  .toc .mono {
    font-size: var(--text-xs);
    line-height: 1.9;
  }

  .prose {
    grid-column: 5 / span 7;
    counter-reset: section;
  }

  .prose :global(h2) {
    counter-increment: section;
    margin-top: var(--space-8);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-2xl);
    font-weight: 540;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h2::before) {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 560;
  }

  .prose :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .prose :global(code) {
    padding: 1px 6px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose :global(p:has(> img)),
  .prose :global(p:has(> a > img)) {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .prose :global(p > img),
  .prose :global(p > a > img) {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .prose :global(a:has(> img)) {
    display: block;
    text-decoration: none;
    cursor: zoom-in;
  }

  .prose :global(p:has(img) em) {
    font-style: normal;
  }

  .prose :global(h3) {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    font-weight: 540;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .prose :global(h2 + h3) {
    margin-top: var(--space-3);
  }

  .prose :global(table) {
    width: 100%;
    margin-top: var(--space-3);
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .prose :global(th) {
    padding: 0 var(--space-2) 10px 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .prose :global(td) {
    padding: 10px var(--space-2) 10px 0;
    border-top: 1px solid var(--color-border);
    vertical-align: top;
    color: var(--color-text-secondary);
  }

  .prose :global(td:first-child) {
    white-space: nowrap;
    color: var(--color-text);
  }

  .prose :global(.swatch) {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 10px;
    vertical-align: -1px;
    border: 1.5px solid var(--swatch);
    border-radius: 3px;
    background: color-mix(in srgb, var(--swatch) 18%, transparent);
  }

  .prose :global(.swatch--dashed) {
    border-style: dashed;
  }

  .prose :global(blockquote) {
    margin-top: var(--space-2);
    padding: 12px var(--space-2);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .prose :global(blockquote p) {
    margin: 0;
    font-size: inherit;
    color: inherit;
  }

  .next {
    border-top: 1px solid var(--color-border);
  }

  .next__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-10);
  }

  .next__title {
    transition: color var(--duration-fast) var(--ease-out);
  }

  .next__arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .next__link:hover .next__title {
    color: var(--color-accent);
  }

  .next__link:hover .next__arrow {
    transform: translateX(6px);
  }

  @media (max-width: 1023px) {
    .intro__copy,
    .meta,
    .prose {
      grid-column: 1 / -1;
    }

    .toc {
      display: none;
    }
  }
</style>
