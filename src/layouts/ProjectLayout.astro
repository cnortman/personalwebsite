---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Sparkline from '../components/charts/Sparkline.astro';
import Status from '../components/ui/Status.astro';
import { padIndex, type Project } from '../lib/projects';

interface Props {
  project: Project;
  headings: MarkdownHeading[];
  index: number;
  next?: Project;
}

const { project, headings, index, next } = Astro.props;
const { title, summary, category, tagline, technologies, status, metrics } = project.data;
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={title} description={summary} type="article">
  <article>
    <header class="project-header">
      <div class="container">
        <a href="/projects" class="back">
          <span aria-hidden="true">←</span> All projects
        </a>

        <div class="grid intro">
          <div class="intro__copy">
            <p class="eyebrow"><span class="muted">{padIndex(index + 1)}</span>&ensp;{category}</p>
            <h1 class="h1" transition:name={`project-title-${project.id}`}>{title}</h1>
            <p class="lede">{summary}</p>
          </div>

          <dl class="meta">
            {
              status && (
                <div>
                  <dt class="eyebrow muted">Status</dt>
                  <dd>
                    <Status status={status} />
                  </dd>
                </div>
              )
            }
            <div>
              <dt class="eyebrow muted">Focus</dt>
              <dd class="mono">{tagline}</dd>
            </div>
            <div>
              <dt class="eyebrow muted">Stack</dt>
              <dd>
                <ul class="chips" role="list">
                  {technologies.map((technology) => <li class="chip">{technology}</li>)}
                </ul>
              </dd>
            </div>
            {
              metrics.map((metric) => (
                <div>
                  <dt class="eyebrow muted">{metric.label}</dt>
                  <dd class="mono">{metric.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="visual" transition:name={`project-visual-${project.id}`}>
          <Sparkline seed={project.id} width={1200} height={220} />
        </div>
      </div>
    </header>

    <div class="container grid body">
      <nav class="toc" aria-label="Case study sections">
        <p class="eyebrow muted">Contents</p>
        <ol role="list">
          {
            sections.map((heading, i) => (
              <li>
                <a href={`#${heading.slug}`}>
                  <span class="mono muted">{padIndex(i + 1)}</span>
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="prose">
        <slot />
      </div>
    </div>

    {
      next && (
        <footer class="next">
          <a href={`/projects/${next.id}`} class="container next__link">
            <span class="eyebrow muted">Next project</span>
            <span class="h2 next__title">
              {next.data.title} <span aria-hidden="true" class="next__arrow">→</span>
            </span>
          </a>
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  .project-header {
    padding-block: var(--space-6) var(--space-8);
  }

  .back {
    display: inline-flex;
    gap: var(--space-1);
    margin-bottom: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .back:hover {
    color: var(--color-text);
  }

  .intro {
    align-items: end;
  }

  .intro__copy {
    grid-column: 1 / span 7;
  }

  .intro__copy > * + * {
    margin-top: var(--space-2);
  }

  .meta {
    grid-column: 9 / span 4;
  }

  .meta > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding-block: 12px;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .meta dd {
    text-align: right;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }

  .visual {
    margin-top: var(--space-8);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  .body {
    align-items: start;
    padding-block: var(--space-8) var(--space-12);
  }

  .toc {
    grid-column: 1 / span 3;
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .toc a {
    display: flex;
    gap: 12px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .toc a:hover {
    color: var(--color-text);
  }

  .toc .mono {
    font-size: var(--text-xs);
    line-height: 1.9;
  }

  .prose {
    grid-column: 5 / span 7;
    counter-reset: section;
  }

  .prose :global(h2) {
    counter-increment: section;
    margin-top: var(--space-8);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-2xl);
    font-weight: 540;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h2::before) {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 560;
  }

  .prose :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .prose :global(code) {
    padding: 1px 6px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose :global(blockquote) {
    margin-top: var(--space-2);
    padding: 12px var(--space-2);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .prose :global(blockquote p) {
    margin: 0;
    font-size: inherit;
    color: inherit;
  }

  .next {
    border-top: 1px solid var(--color-border);
  }

  .next__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-10);
  }

  .next__title {
    transition: color var(--duration-fast) var(--ease-out);
  }

  .next__arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .next__link:hover .next__title {
    color: var(--color-accent);
  }

  .next__link:hover .next__arrow {
    transform: translateX(6px);
  }

  @media (max-width: 1023px) {
    .intro__copy,
    .meta,
    .prose {
      grid-column: 1 / -1;
    }

    .toc {
      display: none;
    }
  }
</style>
